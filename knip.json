{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "cli/main.ts",
    ".claude/hooks/*.mjs",
    ".claude/deleghe.mjs",
    ".claude/riconcilia.mjs",
    "docs/blueprint/mappa/build.mjs",
    "docs/blueprint/mappa/ancore.mjs",
    "core/mcp/fixtures/echo-server.mjs",
    "evals/floor/run.ts",
    "evals/memory/acceptance.ts",
    "evals/voice/drift.ts",
    "evals/character/run.ts",
    "evals/system/sandbox-overhead.ts",
    "evals/acceptance/report.ts",
    "evals/memory/corpus.ts"
  ],
  "project": [
    "**/*.ts",
    "**/*.mjs"
  ],
  "ignore": [
    "docs/blueprint/mappa/mappa.html",
    ".claude/worktrees/**"
  ],
  "ignoreBinaries": [
    "mktemp",
    "systemd-notify",
    "systemd-analyze",
    "loginctl",
    "plutil",
    "bwrap"
  ],
  "ignoreUnresolved": [
    "gateway"
  ],
  "ignoreIssues": {
    "core/memory/consolidator.ts": ["duplicates"],
    "core/memory/embed.ts": ["exports"]
  }
}