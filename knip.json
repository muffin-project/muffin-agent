{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "cli/main.ts",
    ".claude/hooks/*.mjs",
    ".claude/deleghe.mjs",
    "scripts/agent/repo-state.mjs",
    "core/mcp/fixtures/echo-server.mjs",
    "evals/floor/run.ts",
    "evals/memory/acceptance.ts",
    "evals/memory/corpus.ts",
    "evals/voice/drift.ts",
    "evals/system/sandbox-overhead.ts",
    "evals/capability-exposure/run.ts",
    "evals/character/con-la-chiave.ts",
    "evals/reasoning-ab/con-la-chiave.ts",
    "evals/e2e/chatgpt-runtime.ts",
    "evals/e2e/sandbox-probe.mjs"
  ],
  "project": [
    "**/*.ts",
    "**/*.mjs"
  ],
  "ignore": [],
  "ignoreBinaries": [
    "mktemp",
    "script",
    "systemd-notify",
    "systemd-analyze",
    "loginctl",
    "plutil",
    "bwrap"
  ],
  "ignoreUnresolved": [
    "gateway"
  ],
  "ignoreIssues": {
    "core/memory/consolidator.ts": ["duplicates"],
    "core/memory/embed.ts": ["exports"]
  }
}
