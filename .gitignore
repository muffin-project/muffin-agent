node_modules/
dist/
*.log
.DS_Store

# Local generated knowledge graph. The persistent outputs are useful across
# sessions, but they are machine-specific build artefacts, not source.
graphify-out/

# Secrets & local env (hardened before first publish)
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
secrets/
.muffin/

# `muffin update`'s side-by-side releases (git worktrees + current/previous
# bookkeeping) — build output and machine state, never source.
.releases/

# Scratch files a review agent leaves in the shared working tree. It runs in
# THIS tree, so anything it writes is visible to `git add -A` — which swept one
# into a commit and turned the suite red. Ignored by name so a concurrent probe
# cannot be committed by accident.
zz-*
*.probe.ts

# I digest delle deleghe si rigenerano da `node .claude/deleghe.mjs raccogli`.
# Il registro NO: e' l'intento con cui una delega e' partita, e se si perde
# restano transcript anonimi — che e' esattamente il buco che il registro chiude.
.claude/deleghe/*.md

# Character-eval transcripts: evidence of a run, not of the repo.
evals/character/out/
