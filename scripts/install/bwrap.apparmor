# Muffin's AppArmor profile for the Muffin-owned bubblewrap — version 1 (2026-09-28).
#
# Ubuntu 24.04+ restricts unprivileged user namespaces
# (kernel.apparmor_restrict_unprivileged_userns=1). This grants the VERIFIED
# Muffin-owned binary the namespace it needs WITHOUT lowering the kernel-wide
# protection and WITHOUT touching /usr/bin/bwrap.
#
# install.sh substitutes <BWRAP_BINARY> with the realpath of the owned binary
# and loads this file as /etc/apparmor.d/muffin-bwrap. An unsubstituted
# placeholder is a parser error on purpose: a profile that attaches to a path
# no process runs would silently protect nothing.
profile muffin-bwrap <BWRAP_BINARY> flags=(unconfined) {
  userns,
  include if exists <local/bwrap>
}
