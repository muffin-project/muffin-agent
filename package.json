{
  "name": "muffin-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "muffin": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "compile": "tsc -p tsconfig.build.json && rm -rf dist/defaults && cp -R defaults dist/defaults && cp agent/profiles/*.json dist/agent/profiles/",
    "test": "vitest run",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "acceptance:report": "tsx evals/acceptance/report.ts",
    "prepare": "npm run compile"
  },
  "devDependencies": {
    "@grammyjs/types": "^4.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/client": "2.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.7.0",
    "defuddle": "^0.19.2",
    "js-yaml": "^5.2.3",
    "linkedom": "^0.18.13",
    "mathml-to-latex": "^1.8.0",
    "openai": "^7.4.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "unpdf": "1.8.1",
    "zod": "^4.4.3"
  }
}
