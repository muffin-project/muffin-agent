{
  "name": "muffin-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "muffin": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run compile",
    "compile": "tsc -p tsconfig.build.json && rm -rf dist/defaults && cp -R defaults dist/defaults && cp agent/profiles/*.json dist/agent/profiles/",
    "test": "vitest run",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "acceptance:report": "tsx evals/acceptance/report.ts",
    "prepare": "npm run compile && node docs/derived/architecture-map/setup-merge-driver.mjs",
    "test:acceptance:linux": "evals/acceptance/gate-linux.sh . .gate-linux",
    "gate:local": "bash scripts/local-gate.sh",
    "e2e:telegram": "tsx evals/e2e/telegram.ts",
    "eval:character": "tsx evals/character/run.ts",
    "mappa:regen": "node docs/derived/architecture-map/ancore.mjs && node docs/derived/architecture-map/build.mjs && git add docs/derived/architecture-map/ancore.json docs/derived/architecture-map/mappa.html"
  },
  "devDependencies": {
    "@grammyjs/types": "^4.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/client": "2.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.0",
    "defuddle": "^0.19.3",
    "js-yaml": "^5.4.1",
    "linkedom": "^0.18.13",
    "openai": "^7.9.0",
    "sqlite-vec": "^0.1.9",
    "unpdf": "1.8.1",
    "zod": "^4.5.4"
  }
}
